{
    "name": "freeloapp/php-sdk",
    "description": "Modern PHP SDK for Freelo API - Project and task management",
    "type": "library",
    "keywords": [
        "freelo",
        "freeloapp",
        "api",
        "sdk",
        "project-management",
        "task-management",
        "psr-18",
        "http-client"
    ],
    "license": "MIT",
    "homepage": "https://gitlab.com/freeloapp/php-sdk",
    "readme": "README.md",
    "authors": [
        {
            "name": "Freelo Bay s.r.o.",
            "homepage": "https://www.freelo.io"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/freeloapp/php-sdk/-/issues",
        "source": "https://gitlab.com/freeloapp/php-sdk",
        "docs": "https://gitlab.com/freeloapp/php-sdk/-/blob/master/README.md"
    },
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/simple-cache": "^2.0|^3.0",
        "php-http/discovery": "^1.19"
    },
    "suggest": {
        "guzzlehttp/guzzle": "For HTTP client implementation",
        "nyholm/psr7": "For PSR-7 message implementation",
        "symfony/cache": "For caching support"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.8",
        "guzzlehttp/guzzle": "^7.8",
        "symfony/cache": "^6.4|^7.0",
        "php-http/guzzle7-adapter": "^1.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Freelo\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freelo\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html=coverage",
        "phpstan": "phpstan analyse",
        "phpcs": "phpcs",
        "phpcs:fix": "phpcbf",
        "analyse": [
            "@phpstan",
            "@phpcs"
        ],
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
