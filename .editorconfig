# EditorConfig - Consistent coding styles across editors and IDEs
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# YAML files (GitHub workflows, config files)
[*.{yml,yaml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# XML files (phpunit.xml, phpcs.xml, etc.)
[*.xml]
indent_size = 2

# Shell scripts
[*.sh]
end_of_line = lf
