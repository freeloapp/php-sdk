# Freelo PHP SDK - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

# Freelo API Credentials
# Get your API key from: https://freelo.docs.apiary.io/
FREELO_API_EMAIL=your.email@example.com
FREELO_API_KEY=your-api-key-here

# Optional: Specific test project/task IDs for integration tests
# Uncomment and set these if you want to test against specific resources
# FREELO_TEST_PROJECT_ID=123
# FREELO_TEST_TASK_ID=456
